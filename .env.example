# Copy to .env and fill in real values before running `docker compose up -d`.
# Never commit the real .env — it's already in .gitignore.

# --- Domains (production) ---------------------------------------------------
# Leave everything in this section unset for local dev — the defaults below
# already match the Caddyfile (localhost / api.localhost, plain HTTP, no
# certificate). For a real Hetzner deployment, set all four so Caddy issues
# real Let's Encrypt certs and the frontend calls the right API origin.
FRONTEND_DOMAIN=warehouse.example.com
API_DOMAIN=api.warehouse.example.com
# Baked into the frontend's JS bundle at build time (Vite) — must be the
# full origin + /api, matching API_DOMAIN above.
VITE_API_URL=https://api.warehouse.example.com/api
# Used by the backend for CORS — must be the frontend's full origin, matching
# FRONTEND_DOMAIN above.
FRONTEND_URL=https://warehouse.example.com

# --- Postgres ----------------------------------------------------------------
POSTGRES_USER=durby
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=durby_warehouse

# --- Auth ---------------------------------------------------------------------
# Required — the app refuses to start without this (at least 32 characters).
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=12h

# --- Redis ---------------------------------------------------------------------
# Optional for local dev (defaults to a fixed, non-secret placeholder so
# `docker compose up` works with nothing set here). Set a real random value
# for production — Redis has no auth at all otherwise, which matters if a
# port mapping is ever misconfigured to be reachable beyond this machine.
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=change-me-to-a-long-random-value

# --- Frontend build flags -----------------------------------------------------
# Baked into the frontend bundle at build time. MUST be false in production —
# true renders a one-click "demo accounts" list on the login page. (For local
# development, set this to true in your own .env.)
VITE_SHOW_DEMO_LOGINS=false

# --- Demo seed: LOCAL DEVELOPMENT ONLY ---------------------------------------------
# Leave this commented out in production. A real deployment is never seeded: it is
# initialized with `npm run bootstrap:admin` (see DEPLOY.md), and the seed refuses to
# run in production without ALLOW_DEMO_SEED=true and a strong password.
# For local demo data, set a password of at least 12 characters (not the public
# default) shared by the demo logins, then seed as described in DEPLOY.md section 1:
# SEED_DEMO_PASSWORD=

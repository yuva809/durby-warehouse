# Copy to .env.local for standalone `npm run dev` (frontend hot-reload
# against a backend started separately, e.g. `docker compose up backend postgres redis worker`).
# For the full `docker compose up` stack, these are instead passed as build
# args from the root .env — see docker-compose.yml / apps/web/Dockerfile.

VITE_API_URL=http://localhost:3001/api

# Dev/demo convenience only — must match the root .env's SEED_DEMO_PASSWORD.
# Never set this to a real password in a real deployment.
VITE_SEED_DEMO_PASSWORD=ChangeMe123!
VITE_SHOW_DEMO_LOGINS=true

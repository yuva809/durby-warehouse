// Durby Warehouse V2 — schema
// Design notes:
// - `available` stock is NEVER stored; it's always computed as onHand - reserved,
//   both in application code and in the raw-SQL conditional updates used for
//   reservation, so it can never drift from the two numbers that back it.
// - InventoryMovement is the append-only ledger. Nothing about physical stock
//   is trusted unless it is backed by a movement row.
// - ActivityLog is a separate, human-readable audit trail (V1's "Activity"
//   page) — it is NOT the inventory ledger and must not be used to recompute
//   balances.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  WAREHOUSE_MANAGER
  BRANCH_USER
  DRIVER
}

enum LocationType {
  WAREHOUSE
  BRANCH
}

enum RequestStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  CANCELLED
  PARTIALLY_DELIVERED
  DELIVERED
}

enum TransferStatus {
  READY
  ASSIGNED
  PICKING
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
}

enum MovementType {
  RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  DAMAGE
  EXPIRED
  RECOUNT
  ADJUSTMENT
  RETURN
}

enum SupplierInvoiceStatus {
  DRAFT
  UNDER_REVIEW
  CONFIRMED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  /// For BRANCH_USER: the single branch they belong to. Null for other roles.
  locationId   String?
  active       Boolean  @default(true)
  /// True for accounts an admin created with an initial password: the user
  /// must choose their own before anything else works (enforced server-side by
  /// PasswordChangeRequiredGuard). False for existing users and the bootstrap admin.
  passwordChangeRequired Boolean @default(false)
  /// Session revocation. Each JWT carries the version it was issued under (claim
  /// `tv`, absent = 0); a token whose version differs from this is rejected.
  /// Bumped on every password change/reset, which ends all other sessions.
  tokenVersion           Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  location Location? @relation("UserHomeLocation", fields: [locationId], references: [id])

  requestsCreated   StockRequest[]      @relation("RequestCreatedBy")
  requestsReviewed  StockRequest[]      @relation("RequestReviewedBy")
  transfersAsDriver Transfer[]          @relation("TransferDriver")
  transfersConfirmed Transfer[]         @relation("TransferConfirmedBy")
  movements         InventoryMovement[]
  activity          ActivityLog[]
  supplierInvoicesUploaded  SupplierInvoice[] @relation("InvoiceUploadedBy")
  supplierInvoicesConfirmed SupplierInvoice[] @relation("InvoiceConfirmedBy")
  productImagesVerified     ProductImage[]    @relation("ImageVerifiedBy")
  passwordResetTokens       PasswordResetToken[] @relation("ResetTokenUser")
  passwordResetsIssued      PasswordResetToken[] @relation("ResetTokenIssuer")

  @@index([locationId])
}

/// One-time admin-issued password reset code. Only a SHA-256 hash of the code is
/// stored, so a database read never reveals a usable code. The code is shown once
/// to the admin who issues it; the user sets their own new password with it.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  user      User @relation("ResetTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("ResetTokenIssuer", fields: [createdById], references: [id])

  @@index([userId])
}

model Location {
  id        String       @id @default(cuid())
  name      String
  type      LocationType
  shortName String?
  city      String?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users     User[]          @relation("UserHomeLocation")
  inventory InventoryItem[]
  movements InventoryMovement[]
  requests  StockRequest[]
  transfers Transfer[]      @relation("TransferBranch")
}

model Product {
  id         String    @id @default(cuid())
  sku        String    @unique
  name       String
  /// Flat label, kept for backward compatibility with existing filters/PDFs.
  /// The source of truth for the new category-browsing UX is categoryId
  /// below; see ProductCategory for why both exist side by side.
  category   String
  categoryId String?
  /// Real EAN/GTIN/UPC barcode, when known — deliberately separate from
  /// `sku` (our own article number) and from SupplierInvoiceItem.rawProductCode
  /// (whatever code a specific vendor prints on their invoice, which is
  /// never assumed to be a real barcode). Used to match supplier-invoice lines to products.
  barcode    String?   @unique
  brand      String?
  pack       String?
  unit       String
  minStock   Int       @default(0)
  unitPrice  Decimal   @db.Decimal(10, 2)
  expiryDate DateTime?
  sourceRef  String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  categoryRef        ProductCategory?      @relation(fields: [categoryId], references: [id])
  image                ProductImage?
  inventory           InventoryItem[]
  movements            InventoryMovement[]
  requestItems         StockRequestItem[]
  transferItems        TransferItem[]
  supplierInvoiceItems SupplierInvoiceItem[]

  @@index([categoryId])
}

/// Formalizes the Product.category string into a manageable entity (icon,
/// ordering, active flag) for the branch-facing category browsing UX. The
/// plain `Product.category` string stays put — nothing pre-existing that
/// reads it (old filters, PDFs) had to change — this is additive, backfilled
/// from the distinct existing strings; see migration
/// 20260923010000_add_product_category_and_supplier_invoice.
model ProductCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  icon         String?
  description  String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]
}

enum ProductImageStatus {
  /// Lookup ran, nothing plausible came back. imageUrl is null; catalog shows a placeholder.
  NOT_FOUND
  /// A candidate exists but confidence was below the threshold — never shown
  /// in the branch-facing catalog until a manager approves it.
  FOUND_NEEDS_REVIEW
  /// Confidence was at/above the threshold (or an exact barcode hit) — live
  /// in the catalog automatically, but still distinguishable from a
  /// human-confirmed VERIFIED image.
  AUTO_MATCHED
  /// A manager explicitly approved this image (whether it started as
  /// AUTO_MATCHED or FOUND_NEEDS_REVIEW).
  VERIFIED
  /// A manager uploaded their own file — imageData holds the bytes, served
  /// via GET /products/:id/image/file; imageUrl is null.
  MANUAL_UPLOAD
}

/// DORMANT. The product-image feature was removed for V1 and nothing reads or writes this table any more.
/// It is deliberately left in place (empty in production) so that removing the feature needs no destructive
/// migration; drop it in a dedicated migration later if the feature is not coming back.
/// (Original purpose: catalog enrichment only, never touching inventory or blocking stock intake.)
/// One row per product; "search again" overwrites this row rather than
/// keeping a candidate history, matching the rest of this codebase's
/// preference for the simplest thing that satisfies the actual requirement.
model ProductImage {
  id             String             @id @default(cuid())
  productId      String             @unique
  status         ProductImageStatus
  /// External CDN URL for AUTO_MATCHED/VERIFIED/FOUND_NEEDS_REVIEW; null for MANUAL_UPLOAD (see imageData).
  imageUrl       String?
  imageData      Bytes?
  imageMimeType  String?
  /// e.g. "open_food_facts" | "manual" — which ProductImageProvider (or manual upload) produced this.
  source         String?
  /// 0-100, deterministic score — see ProductImageService. Null for MANUAL_UPLOAD (a human chose it directly).
  confidence     Int?
  matchedName    String?
  matchedBrand   String?
  matchedBarcode String?
  /// License/attribution text to display alongside the image where the source requires it (e.g. Open Food Facts is CC BY-SA).
  attribution    String?
  fetchedAt      DateTime?
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation("ImageVerifiedBy", fields: [verifiedById], references: [id])

  @@index([status])
}

/// One row per (location, product). onHand and reserved are only ever
/// mutated by InventoryService inside a transaction that also writes a
/// matching InventoryMovement row (for onHand changes).
model InventoryItem {
  id         String   @id @default(cuid())
  locationId String
  productId  String
  onHand     Int      @default(0)
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([locationId, productId])
  @@index([productId])
}

/// Append-only inventory ledger. Every physical stock change is one row here.
model InventoryMovement {
  id         String       @id @default(cuid())
  productId  String
  locationId String
  /// Signed delta applied to onHand at this location for this product.
  quantity   Int
  type       MovementType
  /// Human-facing reference, e.g. a request/transfer code (REQ-1024, TR-1024).
  reference  String?
  reason     String?
  userId     String?
  createdAt  DateTime     @default(now())

  product  Product   @relation(fields: [productId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([productId, locationId])
  @@index([reference])
  @@index([createdAt])
}

model StockRequest {
  id              String        @id @default(cuid())
  code            String        @unique
  /// Customer-facing Order Confirmation number (OC-000001...), assigned once
  /// at creation via CodesService — a separate, independently-numbered
  /// sequence from `code`. `code` (REQ-xxxx) stays the internal/API
  /// identifier; ocNumber is what appears on documents and in the branch UI.
  ocNumber        String        @unique
  branchId        String
  status          RequestStatus @default(PENDING)
  createdById     String
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branch     Location           @relation(fields: [branchId], references: [id])
  createdBy  User               @relation("RequestCreatedBy", fields: [createdById], references: [id])
  reviewedBy User?              @relation("RequestReviewedBy", fields: [reviewedById], references: [id])
  items      StockRequestItem[]
  transfer   Transfer?

  @@index([branchId, status])
}

model StockRequestItem {
  id           String @id @default(cuid())
  requestId    String
  productId    String
  requestedQty Int
  approvedQty  Int?

  request StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@unique([requestId, productId])
}

model Transfer {
  id             String         @id @default(cuid())
  code           String         @unique
  /// Customer-facing Delivery Challan number (DC-000001...), assigned once at
  /// dispatch() — the point the challan first represents something real
  /// (goods have actually left the warehouse). Null before dispatch.
  dcNumber       String?        @unique
  requestId      String         @unique
  branchId       String
  status         TransferStatus @default(READY)
  driverId       String?
  etaDate        DateTime?
  etaWindowStart String?
  etaWindowEnd   String?
  outForDeliveryAt DateTime?
  deliveredAt    DateTime?
  failedReason   String?
  failedAt       DateTime?
  confirmedAt    DateTime?
  confirmedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  request      StockRequest   @relation(fields: [requestId], references: [id])
  branch       Location       @relation("TransferBranch", fields: [branchId], references: [id])
  driver       User?          @relation("TransferDriver", fields: [driverId], references: [id])
  confirmedBy  User?          @relation("TransferConfirmedBy", fields: [confirmedById], references: [id])
  items        TransferItem[]

  @@index([branchId, status])
  @@index([driverId, status])
}

model TransferItem {
  id           String @id @default(cuid())
  transferId   String
  productId    String
  /// Planned quantity, copied from the request's approvedQty at approval time.
  approvedQty  Int
  /// Actual quantity picked by the driver — authoritative for the stock
  /// movement created at dispatch. Null until picking is recorded.
  pickedQty    Int?
  /// Actual quantity the branch received — defaults to pickedQty at delivery
  /// time but can be adjusted down if something didn't make it (breakage etc).
  deliveredQty Int?
  /// Why pickedQty is less than approvedQty (damaged, rotten, out of stock at
  /// pick time, etc). Required by the service layer whenever picked <
  /// approved; null otherwise. Surfaced on the Delivery Challan.
  shortageReason String?

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([transferId, productId])
}

/// A manager-uploaded supplier invoice/delivery note (PDF/CSV/XLSX/XLSM),
/// staged for review before any stock is added. Uploading NEVER changes
/// inventory by itself — only confirm() (SupplierInvoicesService) does, and
/// only onHand, via InventoryService.applyMovement, exactly like every other
/// stock change in this system. DRAFT/UNDER_REVIEW -> CONFIRMED is claimed
/// with the same single conditional UPDATE pattern used by
/// approve()/dispatch()/markDelivered(), so a duplicate confirm click cannot
/// double-add stock.
model SupplierInvoice {
  id             String                @id @default(cuid())
  code           String                @unique
  supplierName   String
  invoiceNumber  String
  invoiceDate    DateTime?
  status         SupplierInvoiceStatus @default(DRAFT)
  sourceFileName String?
  sourceFileType String?
  sourceFileData Bytes?
  uploadedById   String
  confirmedById  String?
  confirmedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  uploadedBy  User                  @relation("InvoiceUploadedBy", fields: [uploadedById], references: [id])
  confirmedBy User?                 @relation("InvoiceConfirmedBy", fields: [confirmedById], references: [id])
  items       SupplierInvoiceItem[]

  @@index([status])
  @@index([createdAt])
}

model SupplierInvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  /// Null until matched (auto-matched or manually resolved by the manager).
  productId      String?
  rawDescription String
  rawProductCode String?
  unit           String?
  /// Quantity as printed on the supplier's invoice — never written to
  /// inventory directly.
  invoiceQty     Int
  /// Manager-confirmed quantity actually received — this, not invoiceQty, is
  /// what confirm() adds to onHand. Null until reviewed.
  receivedQty    Int?
  matchConfidence String? // 'exact' | 'fuzzy' | 'unmatched'
  needsReview    Boolean @default(true)

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@index([invoiceId])
}

/// Human-readable narrative audit trail (V1's Activity page). NOT the
/// inventory ledger — see InventoryMovement for that.
model ActivityLog {
  id        String   @id @default(cuid())
  message   String
  kind      String
  userId    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

/// Monotonic per-prefix counters for human-friendly codes (REQ-1024, TR-1024,
/// OC-000001, DC-000001, INV-000001), generated via a single atomic
/// UPDATE ... RETURNING so concurrent creates never collide — see
/// CodesService.
model CodeSequence {
  prefix String @id
  value  Int    @default(1023)
}
